{
  "name": "dismoji",
  "version": "0.1.0",
  "description": "Emoji Kitchen mashup tab for Discord, as a Vencord userplugin",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
